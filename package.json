{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "yarn start:all",
    "start:en": "yarn --cwd sites/en start --port 3000",
    "start:cn": "yarn --cwd sites/zh-CN start --port 3001",
    "start:ja": "yarn --cwd sites/ja start --port 3002",
    "start:es": "yarn --cwd sites/es start --port 3003",
    "start:en+cn": "concurrently -n en,cn -c blue,green \"yarn start:en\" \"yarn start:cn\"",
    "start:all": "concurrently -n en,cn,ja,es -c blue,green,yellow,magenta \"yarn start:en\" \"yarn start:cn\" \"yarn start:ja\" \"yarn start:es\"",
    "build": "yarn build:all",
    "build:en": "yarn --cwd sites/en build -- --out-dir ../../build",
    "build:cn": "yarn --cwd sites/zh-CN build -- --out-dir ../../build/cn",
    "build:ja": "yarn --cwd sites/ja build -- --out-dir ../../build/ja",
    "build:es": "yarn --cwd sites/es build -- --out-dir ../../build/es",
    "build:all": "yarn build:en && yarn build:cn && yarn build:ja && yarn build:es",
    "serve": "docusaurus serve",
    "swizzle": "docusaurus swizzle",
    "deploy": "yarn build && gh-pages -d build -b gh-pages",
    "clear": "docusaurus clear",
    "install:frozen": "yarn install --frozen-lockfile",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "generatewiki": "node scripts/generateWiki.js",
    "generate-lang-map": "node scripts/generate-language-map.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@babel/helper-split-export-declaration": "^7.24.7",
    "@docusaurus/core": "3.8.1",
    "@docusaurus/faster": "^3.8.1",
    "@docusaurus/plugin-client-redirects": "3.8.1",
    "@docusaurus/plugin-content-docs": "3.8.1",
    "@docusaurus/plugin-debug": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@docusaurus/theme-common": "3.8.1",
    "@docusaurus/theme-live-codeblock": "3.8.1",
    "@giscus/react": "^2.2.4",
    "@mdx-js/react": "^3.1.0",
    "antd": "^5.19.3",
    "chalk": "^5.4.1",
    "clsx": "^1.2.1",
    "docusaurus-plugin-image-zoom": "^0.1.4",
    "docusaurus-plugin-sass": "^0.2.2",
    "docusaurus-theme-search-typesense": "^0.25.0",
    "estree-util-value-to-estree": "^3.5.0",
    "moment": "^2.30.1",
    "prism-react-renderer": "^1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-icons": "^5.3.0",
    "react-popper": "^2.3.0",
    "react-toastify": "^10.0.6",
    "react-tweet": "^3.2.2",
    "rehype-katex": "^6.0.0",
    "remark-math": "5.0.0",
    "sass": "^1.89.1",
    "swiper": "^11.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "3.8.1",
    "@docusaurus/module-type-aliases": "3.8.1",
    "@tsconfig/docusaurus": "^1.0.5",
    "baseline-browser-mapping": "^2.9.14",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "glob": "^11.0.2",
    "typescript": "^4.7.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
