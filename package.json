{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 docusaurus start --host 0.0.0.0",
    "start:en": "cross-env NODE_ENV=development DOC_LANGS=en NODE_OPTIONS=--max-old-space-size=6144 docusaurus start --host 0.0.0.0",
    "start:cn": "cross-env NODE_ENV=development DOC_LANGS=zh-CN NODE_OPTIONS=--max-old-space-size=6144 docusaurus start --host 0.0.0.0",
    "start:en+cn": "cross-env NODE_ENV=development DOC_LANGS=en,zh-CN NODE_OPTIONS=--max-old-space-size=6144 docusaurus start --host 0.0.0.0",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 docusaurus build",
    "serve": "docusaurus serve",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "install:frozen": "yarn install --frozen-lockfile",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "generatewiki": "node scripts/generateWiki.js",
    "generate-lang-map": "node scripts/generate-language-map.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@babel/helper-split-export-declaration": "^7.24.7",
    "@docusaurus/core": "3.8.1",
    "@docusaurus/faster": "^3.8.1",
    "@docusaurus/plugin-client-redirects": "3.8.1",
    "@docusaurus/plugin-content-docs": "3.8.1",
    "@docusaurus/plugin-debug": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@docusaurus/theme-common": "3.8.1",
    "@docusaurus/theme-live-codeblock": "3.8.1",
    "@giscus/react": "^2.2.4",
    "@mdx-js/react": "^3.1.0",
    "antd": "^5.19.3",
    "chalk": "^5.4.1",
    "clsx": "^1.2.1",
    "docusaurus-plugin-image-zoom": "^0.1.4",
    "docusaurus-plugin-sass": "^0.2.2",
    "docusaurus-theme-search-typesense": "^0.25.0",
    "estree-util-value-to-estree": "^3.5.0",
    "moment": "^2.30.1",
    "prism-react-renderer": "^1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-icons": "^5.3.0",
    "react-popper": "^2.3.0",
    "react-toastify": "^10.0.6",
    "react-tweet": "^3.2.2",
    "rehype-katex": "^6.0.0",
    "remark-math": "5.0.0",
    "sass": "^1.89.1",
    "swiper": "^11.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "3.8.1",
    "@docusaurus/module-type-aliases": "3.8.1",
    "@tsconfig/docusaurus": "^1.0.5",
    "baseline-browser-mapping": "^2.9.14",
    "cross-env": "^10.1.0",
    "glob": "^11.0.2",
    "typescript": "^4.7.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
